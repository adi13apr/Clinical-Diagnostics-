# Copy to .env (gitignored) and fill in. Read by docker compose and scripts/multi_replica_demo.py.
# Placeholders only: never put real values in this file.

# Supabase project (Project Settings -> API). The PUBLISHABLE key, never the secret/service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated browser origins allowed by CORS (localhost is always allowed)
FRONTEND_URL=https://your-frontend.example.com

# Groq key for the report agent; empty -> every report uses the template (no LLM)
GROQ_API_KEY=

# Report pipeline: single (default, one tool-calling agent) or multi (evidence agent, writer, verifier)
REPORT_PIPELINE=single

# Host ports (localhost only). serve_local_api.ps1 already uses 7860.
API_PORT=7861
REDIS_PORT=6380

# Replica counts (docker compose up --scale worker=N overrides WORKER_REPLICAS)
API_REPLICAS=2
WORKER_REPLICAS=1

# scripts/multi_replica_demo.py signs in with these (Supabase email/password account),
# unless SUPABASE_ACCESS_TOKEN is set in the shell
DEMO_EMAIL=you@example.com
DEMO_PASSWORD=
