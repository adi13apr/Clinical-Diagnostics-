# Copy to .env.local (gitignored) and fill in. Vite only exposes variables that start with VITE_.
# The publishable key is public by design; row-level security protects the data. Never use the secret key.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key, sb_publishable_...>
